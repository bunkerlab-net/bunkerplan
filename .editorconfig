# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
tab_width = 2

# Markdown carries no override on purpose. Hard breaks written as two trailing
# spaces would need `trim_trailing_whitespace = false`, and this repo does not
# use them - none of its own `.md` files contain one. An override repeating the
# default above would only look like it protected something.

# hk.pkl, the pre-commit config. Pkl is Apple's configuration language, not
# Python's pickle format - the file is source, and it is indented like the rest.
[*.pkl]
indent_size = 2
