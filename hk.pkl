// https://hk.jdx.dev
amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

// Hash-locked upstream skills and generated artifacts must stay byte-for-byte
// unchanged. Bun and Oxlint also exclude these in their own configurations so
// standalone commands and hooks use the same policy.
local vendored = List(".agents/skills/**")
local generated =
  List(
    "drizzle/**",
    "worker-configuration.d.ts",
    "src/server/manifest.generated.ts",
    "public/scalar/**",
  )

local linters = new Mapping<String, Step> {
  // https://hk.jdx.dev/builtins.html
  ["oxlint"] = new Step {
    glob = List("*.js", "*.jsx", "*.mjs", "*.cjs", "*.ts", "*.tsx", "*.mts", "*.cts")
    exclude = vendored + generated
    check = "bun run lint --no-error-on-unmatched-pattern {{ files }}"
    fix = "bun run lint:fix --no-error-on-unmatched-pattern {{ files }}"
  }
  ["bun_fmt"] = new Step {
    glob =
      List(
        "*.js",
        "*.jsx",
        "*.mjs",
        "*.cjs",
        "*.ts",
        "*.tsx",
        "*.mts",
        "*.cts",
        "*.json",
        "*.jsonc",
        "*.json5",
        "*.css",
        "*.html",
        "*.yaml",
        "*.yml",
        "*.toml",
        "*.md",
        "*.mdx",
      )
    exclude = List(".vscode/**", ".zed/**", "mise.toml") + vendored + generated
    depends = List("oxlint", "sort_package_json")
    check = "bun fmt --check {{ files }}"
    fix = "bun fmt {{ files }}"
  }
  // Detect accidentally committed private keys. Deliberately NOT excluded
  // from `.agents/skills` - vendored content still gets scanned.
  ["detect_private_key"] = Builtins.detect_private_key
  // Preserve mise's own configuration formatter.
  ["mise"] = Builtins.mise
  // Ensure all files end with LF (*nix) not CRLF (DOS)
  ["mixed_line_ending"] = (Builtins.mixed_line_ending) {
    exclude = vendored
  }
  // Ensure all files end in a new line
  ["newlines"] = (Builtins.newlines) {
    exclude = vendored
  }
  // Format Pickle files
  ["pkl_format"] = Builtins.pkl_format
  // Lint Pickle files
  ["pkl_lint"] = Builtins.pkl
  // Sort package.json keys, including nested scripts and dependency maps.
  ["sort_package_json"] = (Builtins.sort_package_json) {
    check = "bun sort-package-json --check {{ files }}"
    fix = "bun sort-package-json {{ files }}"
  }
  // No trailing whitespace allowed
  ["trailing_whitespace"] = (Builtins.trailing_whitespace) {
    exclude = vendored
  }
}

hooks {
  ["pre-commit"] {
    steps = linters
    stash = "git"
  }

  // "fix" and "check" are special steps for `hk fix` and `hk check` commands
  ["fix"] {
    fix = true
    steps = linters
  }

  ["check"] {
    steps = linters
  }
}
