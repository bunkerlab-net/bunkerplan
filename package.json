{
  "name": "bunkerplan",
  "private": true,
  "repository": "https://github.com/bunkerlab-net/bunkerplan",
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "auth:generate:pg": "bun auth generate --config src/db/gen/auth.pg.ts --output src/db/schema/auth.pg.ts --yes",
    "auth:generate:sqlite": "bun auth generate --config src/db/gen/auth.sqlite.ts --output src/db/schema/auth.sqlite.ts --yes",
    "build": "vite build",
    "build:node": "BUILD_TARGET=node vite build",
    "cf-typegen": "wrangler types",
    "check": "biome check",
    "clean": "rm -rf .output .tanstack .wrangler dist node_modules",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts",
    "db:migrate:pg": "drizzle-kit migrate --config drizzle.pg.config.ts",
    "db:migrate:sqlite": "drizzle-kit migrate --config drizzle.sqlite.config.ts",
    "deploy": "bun run scripts/check-deploy-config.ts && bun run build && wrangler deploy -c dist/server/wrangler.json",
    "dev": "vite dev --port 3000",
    "start": "node .output/server/index.mjs",
    "test": "bun test --parallel",
    "test:backends": "BETTER_AUTH_SECRET=unused-the-app-service-is-never-started docker compose -p bunkerplan-test -f docker-compose.yml -f docker-compose.test.yml up -d --wait postgres valkey minio",
    "test:backends:down": "BETTER_AUTH_SECRET=unused-the-app-service-is-never-started docker compose -p bunkerplan-test -f docker-compose.yml -f docker-compose.test.yml down -v",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@better-auth/api-key": "^1.6.25",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "@elastic/ecs-pino-format": "^1.5.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "nanoid": "^6.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ultrahtml": "^1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "auth": "^1.6.25",
    "drizzle-kit": "^0.31.10",
    "miniflare": "^4.20260722.0",
    "nitro": "^3.0.260610-beta",
    "sort-package-json": "^4.0.0",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
