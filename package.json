{
  "name": "bunkerplan",
  "private": true,
  "repository": "https://github.com/bunkerlab-net/bunkerplan",
  "type": "module",
  "module": "src/node.ts",
  "scripts": {
    "auth:generate:pg": "bun auth generate --config src/db/gen/auth.pg.ts --output src/db/schema/auth.pg.ts --yes",
    "auth:generate:sqlite": "bun auth generate --config src/db/gen/auth.sqlite.ts --output src/db/schema/auth.sqlite.ts --yes",
    "build": "bun run scripts/build.ts",
    "cf-typegen": "wrangler types",
    "check": "biome check",
    "clean": "rm -rf .wrangler dist node_modules src/server/manifest.generated.ts",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts",
    "db:migrate:pg": "drizzle-kit migrate --config drizzle.pg.config.ts",
    "db:migrate:sqlite": "drizzle-kit migrate --config drizzle.sqlite.config.ts",
    "deploy": "bun run scripts/check-deploy-config.ts && bun run build && wrangler deploy",
    "dev": "bun run scripts/dev.ts",
    "dev:node": "bun run scripts/dev.ts node",
    "postinstall": "bun run scripts/vendor-scalar.ts",
    "start": "bun dist/server/index.js",
    "test": "bun run build && bun test --parallel",
    "test:backends": "BETTER_AUTH_SECRET=unused-the-app-service-is-never-started docker compose -p bunkerplan-test -f docker-compose.yml -f docker-compose.test.yml up -d --wait postgres valkey minio",
    "test:backends:down": "BETTER_AUTH_SECRET=unused-the-app-service-is-never-started docker compose -p bunkerplan-test -f docker-compose.yml -f docker-compose.test.yml down -v",
    "typecheck": "bun run build && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@better-auth/api-key": "^1.6.25",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "@elastic/ecs-pino-format": "^1.5.0",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "ioredis": "^5.11.1",
    "nanoid": "^6.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ultrahtml": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@scalar/api-reference": "^1.63.0",
    "@scalar/openapi-parser": "^0.28.10",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "auth": "^1.6.25",
    "drizzle-kit": "^0.31.10",
    "miniflare": "^4.20260722.0",
    "sort-package-json": "^4.0.0",
    "wrangler": "^4.114.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
