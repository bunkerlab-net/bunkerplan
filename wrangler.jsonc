{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bunkerplan",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "dist/client",
  },
  // Without this, `wrangler deploy` DROPS the custom domain configured in the
  // dashboard and the Worker stops answering on plan.bunkerlab.net. Deploy
  // treats this file as the source of truth for routes, not the dashboard.
  //
  // `zone_name` is not valid alongside `custom_domain` — the schema forbids
  // it and Cloudflare infers the zone from the hostname.
  "routes": [
    {
      "pattern": "plan.bunkerlab.net",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
  // plan.bunkerlab.net is the ONLY origin this app can authenticate on:
  // `origin` in src/auth/options.ts is pinned to PUBLIC_BASE_URL, so a
  // *.workers.dev or preview URL would serve a mirror where every passkey
  // ceremony fails, plus a second public URL for uploaded plans.
  //
  // Both are stated outright because they are not simply defaults. Defining
  // `routes` already forces workers_dev to false, and leaving that implicit
  // hides a real change from whoever reads this next. Set both to true to
  // restore the fallback URLs.
  "workers_dev": false,
  "preview_urls": false,
  // BETTER_AUTH_SECRET is a secret, never a var:
  //   wrangler secret put BETTER_AUTH_SECRET
  //
  // NOTE: bindings are NOT inherited by named environments. If you add
  // `[env.staging]`, repeat all three blocks below inside it — a missing
  // binding fails at runtime, not at deploy time.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bunkerplan",
      "database_id": "03db4e11-d2e2-43b9-a31c-cc0ed6c36e87",
      "migrations_dir": "drizzle/sqlite",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      // `wrangler r2 bucket create bunkerplan`
      "bucket_name": "bunkerplan",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      // `wrangler kv namespace create KV` prints the real id.
      "id": "a28cd77677104536b3641ce51776e20d",
    },
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://plan.bunkerlab.net",
    // DO NOT REMOVE OR CHANGE once anyone has registered. This is the WebAuthn
    // relying-party id; every stored credential is bound to it. While a
    // different value is in place no existing passkey can be used, and since
    // there is no password there is no other way in — restoring this exact
    // value is the only fix. Migrating away deliberately means every user
    // re-registers from scratch.
    //
    // It is set explicitly because the default is the hostname of
    // PUBLIC_BASE_URL, which would be `plan.bunkerlab.net`. The parent domain
    // scopes credentials to bunkerlab.net instead. That alone does NOT let
    // other subdomains run ceremonies — `origin` in src/auth/options.ts is
    // pinned to PUBLIC_BASE_URL — but it keeps that possible later without
    // invalidating anything already registered.
    "RP_ID": "bunkerlab.net",
  },
}
