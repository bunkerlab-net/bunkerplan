# BunkerPlan environment contract. Copy to `.env` and fill in.
# On Cloudflare Workers, `wrangler dev` / `vite dev` read this file for local
# bindings; in production use `wrangler secret put BETTER_AUTH_SECRET`.
# For Docker/self-hosting, pass these as container environment variables.
#
# Full reference: docs/self-hosting.md

# --- Required everywhere ---------------------------------------------------

# Minimum 32 characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Must match the browser origin EXACTLY or WebAuthn will reject the ceremony.
PUBLIC_BASE_URL=http://localhost:3000

# The single header your reverse proxy OVERWRITES with the client IP. Required
# unless running on Cloudflare Workers, where `cf-connecting-ip` is the default
# because the edge sets it. Startup fails without it: a header the client can
# set itself lets it forge a fresh auth rate-limit bucket per request, and a
# header your proxy APPENDS to arrives as a chain, resolves to no IP, and puts
# every caller in one shared bucket that a single client can exhaust.
CLIENT_IP_HEADER=x-forwarded-for

# --- Optional --------------------------------------------------------------

# WebAuthn relying-party id. Defaults to the hostname of PUBLIC_BASE_URL, and
# must be that hostname or a parent of it - startup rejects anything else,
# because no ceremony could succeed with it.
# Must be a registrable domain, so a bare label like `bunkerplan` is rejected.
# Set it to a parent domain only if passkeys need to work across subdomains.
# CANNOT be changed later without invalidating every registered passkey.
#RP_ID=plan.bunkerlab.net
#RP_NAME=BunkerPlan

#MAX_UPLOAD_BYTES=2097152
# Stored plans per account. With MAX_UPLOAD_BYTES this is the ceiling on what
# one account can occupy; the rate limit only caps how fast it writes. No
# maximum here; on Workers it is refused above 400, because account deletion
# sweeps the objects one at a time within one invocation's subrequest budget.
#MAX_PLANS_PER_USER=250
#UPLOAD_RATE_MAX=30
# Minimum 60, refused below it. UPLOAD_RATE_MAX is a count per window, so a
# shorter window raises the sustained rate while reading like a tightening.
#UPLOAD_RATE_WINDOW_SEC=60

# Share-code redemptions per window, per client address. Redeeming is the one
# route that takes no credential, so its bucket is the address from
# CLIENT_IP_HEADER rather than an account. This bounds what an anonymous caller
# can spend, not what it can guess - guessing is answered by SHARE_CODE_LENGTH.
# Per address and never per plan: the plan id is in the share link, so a
# per-plan bucket would let anyone holding the link lock the other readers out.
#UNLOCK_RATE_MAX=30
# Defaults to 60, and must be at least 1 like every other integer here. What it
# does not have is the 60s floor on the upload window: that guards the storage
# uploads consume, and a redemption stores nothing.
#UNLOCK_RATE_WINDOW_SEC=60

# Characters in a generated plan id, 8 to 63. A plan URL is public and
# unlisted, so the id is the only thing standing between a document and
# someone guessing at it. Lowercase alphanumeric, and no longer than a DNS
# label holds, so an id is always usable as a hostname.
#PLAN_ID_LENGTH=16

# Characters in a generated share code, 16 to 64. A share code is the only
# thing gating an unauthenticated read of a private plan, so there is no short
# end worth allowing: 16 mixed-case alphanumeric characters is about 95 bits.
# Lowering this never invalidates codes already minted.
#SHARE_CODE_LENGTH=16

# --- Logging ---------------------------------------------------------------

# json  = Elastic Common Schema, one object per line (@elastic/ecs-pino-format)
# plain = human-readable lines (pino-pretty)
#LOG_FORMAT=json
#LOG_LEVEL=info
# Only affects LOG_FORMAT=plain. Off by default so captured logs stay clean.
#LOG_COLOR=false

# --- Drivers ---------------------------------------------------------------
# On Workers these default to the bindings (r2 / d1 / kv) and must be left
# unset. When self-hosting, all three are REQUIRED.

#STORAGE_DRIVER=s3
#DB_DRIVER=postgres
#KV_DRIVER=valkey

# --- Object storage (STORAGE_DRIVER=s3) ------------------------------------

#S3_BUCKET=bunkerplan
# OMIT for real AWS S3. Set for MinIO / R2's S3 API / GCS.
#S3_ENDPOINT=http://minio:9000
# OMIT BOTH on AWS to use the instance/task/IRSA role. Setting exactly one is a
# configuration error. Required only for stores with no credential chain.
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
# Use `auto` for R2.
#S3_REGION=us-east-1
# MinIO, R2, and GCS need path-style. Set false for real AWS S3.
#S3_FORCE_PATH_STYLE=true

# --- Database --------------------------------------------------------------

# DB_DRIVER=postgres
#DATABASE_URL=postgres://bunkerplan:bunkerplan@postgres:5432/bunkerplan
# DB_DRIVER=sqlite - Bun runtime only.
#SQLITE_PATH=./data/bunkerplan.db

# --- KV --------------------------------------------------------------------

# KV_DRIVER=valkey
#VALKEY_URL=redis://valkey:6379

# --- Tests -----------------------------------------------------------------
# Read by tests/drivers/backends.ts only. The application ignores every one of
# them, so they are safe to leave set - they name the throwaway servers the
# driver conformance suites run against, never anything this deployment uses.
#
# Each backend is opt-in and SKIPS when its variable is unset, which is what
# lets `bun run test` pass on a checkout with no Docker. That also means
# leaving them commented out quietly halves what the suite proves: the
# Cloudflare drivers (D1, R2, Workers KV) run on Miniflare either way, but
# Postgres, MinIO, and Valkey do not run at all. CI sets all five.
#
# `bun test` loads this file, so uncommenting here is enough - no export, no
# prefix on the command. Bring the servers up first:
#
#   bun run test:backends        # and `bun run test:backends:down` after
#
# Ports match docker-compose.test.yml, which publishes them on localhost.

# Postgres. Each run works inside a scratch schema that is dropped afterwards,
# so this may point at a database that already holds a `plan` table.
#TEST_DATABASE_URL=postgres://bunkerplan:bunkerplan@127.0.0.1:5432/bunkerplan

# Valkey. Keys are namespaced per run rather than flushed, so a shared server
# stays usable - but expect leftovers, and never point this at a real one.
#TEST_VALKEY_URL=redis://127.0.0.1:6379

# MinIO, or anything else speaking the S3 API. Each run CREATES its own bucket
# and deletes it at the end, so no bucket name is configurable on purpose: a
# suite that can empty a bucket somebody chose is not worth running.
#TEST_S3_ENDPOINT=http://127.0.0.1:9000

# Optional, and only needed if the endpoint above is not the compose MinIO.
# They default to its credentials, which is why the line above is enough on
# its own. Unlike S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY, there is no
# credential chain to fall back to here - the defaults are the fallback.
#TEST_S3_ACCESS_KEY_ID=minioadmin
#TEST_S3_SECRET_ACCESS_KEY=minioadmin
